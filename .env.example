# Telegram
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
WEBHOOK_SECRET=change-me-to-a-long-random-string
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=https://your-domain.example.com

# Mode: polling | webhook
BOT_MODE=polling

# Database
POSTGRES_USER=giveaway_bot
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=giveaway
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://giveaway_bot:change-me-strong-password@db:5432/giveaway

# Redis
REDIS_URL=redis://redis:6379/0

# Admins (comma-separated Telegram user IDs)
ADMIN_IDS=123456789,987654321

# Security
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
INVITE_LINK_RATE_LIMIT_PER_HOUR=5
MEMBERSHIP_CHECK_COOLDOWN_SECONDS=30

# Giveaway defaults
DEFAULT_TIMEZONE=Europe/Moscow
VERIFICATION_PERIOD_HOURS=48
APPEAL_PERIOD_HOURS=72
DATA_RETENTION_DAYS=365

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Health
HEALTH_PORT=8080
